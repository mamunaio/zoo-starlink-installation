---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'phone' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  id,
  target,
  rel,
  ariaLabel,
  ...rest
} = Astro.props;

const baseClass = `btn btn-${variant} btn-${size} ${className}`.trim();
---

{
  href ? (
    <a
      href={href}
      class={baseClass}
      id={id}
      target={target}
      rel={target === '_blank' ? (rel || 'noopener noreferrer') : rel}
      aria-label={ariaLabel}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={baseClass}
      id={id}
      aria-label={ariaLabel}
      {...rest}
    >
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.625rem;
    border: 1px solid transparent;
    transition: all var(--transition-fast);
    white-space: nowrap;
    cursor: pointer;
    line-height: 1.2;
    text-align: center;
  }

  /* Sizes */
  .btn-sm {
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
  }

  .btn-md {
    font-size: 1rem;
    padding: 0.75rem 1.5rem;
  }

  .btn-lg {
    font-size: 1.125rem;
    padding: 0.95rem 2rem;
    border-radius: 0.75rem;
  }

  /* Primary (Blue System) */
  .btn-primary {
    background: #3b82f6;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 14px rgba(59, 130, 246, 0.35);
  }

  .btn-primary:hover {
    background: #2563eb;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  /* Secondary (Starlink Blue/Cyan) */
  .btn-secondary {
    background: linear-gradient(135deg, var(--starlink-blue) 0%, #1d4ed8 100%);
    color: var(--text-white);
    border-color: rgba(56, 189, 248, 0.3);
    box-shadow: 0 4px 14px var(--starlink-blue-glow);
  }

  .btn-secondary:hover {
    background: linear-gradient(135deg, var(--starlink-cyan) 0%, var(--starlink-blue) 100%);
    color: var(--text-white);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(14, 165, 233, 0.45);
  }

  /* Phone Specific (Direct Call Accent) */
  .btn-phone {
    background: rgba(37, 99, 235, 0.15);
    color: #60a5fa;
    border-color: rgba(59, 130, 246, 0.4);
  }

  .btn-phone:hover {
    background: var(--starlink-blue);
    color: var(--text-white);
    border-color: var(--starlink-blue);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px var(--starlink-blue-glow);
  }

  /* Outline */
  .btn-outline {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-heading);
    border-color: var(--border-medium);
    backdrop-filter: blur(8px);
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--starlink-cyan-light);
    color: var(--text-white);
    transform: translateY(-2px);
  }

  /* Ghost */
  .btn-ghost {
    background: transparent;
    color: var(--text-muted);
  }

  .btn-ghost:hover {
    color: var(--text-white);
    background: rgba(255, 255, 255, 0.06);
  }
</style>
