---
const stats = [
  {
    icon: '⚡',
    title: '100+ Mbps Speeds',
    subtitle: 'High-speed, 25–30ms low-latency setup',
  },
  {
    icon: '⛈️',
    title: 'QLD Storm-Proofed',
    subtitle: 'Weather-sealed mounts for heavy rain & winds',
  },
  {
    icon: '💻',
    title: 'IT & Network Specialists',
    subtitle: 'Whole-home WiFi, mesh & ethernet routing',
  },
  {
    icon: '📍',
    title: 'Greater Brisbane Dispatch',
    subtitle: 'Prompt local technicians across SE Queensland',
  },
];
---

<section class="trust-bar-section" aria-label="Key Service Highlights">
  <div class="container">
    <div class="trust-grid">
      {stats.map((item) => (
        <div class="trust-card">
          <div class="trust-icon-box" aria-hidden="true">{item.icon}</div>
          <div class="trust-text">
            <h3 class="trust-card-title">{item.title}</h3>
            <p class="trust-card-desc">{item.subtitle}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust-bar-section {
    background: rgba(15, 23, 42, 0.7);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.75rem 0;
    position: relative;
    z-index: 2;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .trust-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid transparent;
    transition: all var(--transition-fast);
  }

  .trust-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(56, 189, 248, 0.2);
  }

  .trust-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 0.625rem;
    background: rgba(14, 165, 233, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
  }

  .trust-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .trust-card-title {
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-white);
    line-height: 1.2;
  }

  .trust-card-desc {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.35;
    margin: 0;
  }
</style>
