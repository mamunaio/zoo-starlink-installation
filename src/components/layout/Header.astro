---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';

const navLinks = [
  { label: 'Why IT Pros', href: '#why-professional' },
  { label: 'Services', href: '#services' },
  { label: 'DIY Risks', href: '#diy-risks' },
  { label: 'Cost Factors', href: '#pricing' },
  { label: 'Service Areas', href: '#service-areas' },
  { label: 'FAQs', href: '#faq' },
];
---

<header class="site-header" id="top">
  <!-- Announcement Bar -->
  <div class="announcement-bar">
    <div class="container announcement-content">
      <div class="announcement-left">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span><strong>Fast Local Dispatch:</strong> Starlink installations across Greater Brisbane & South East Queensland</span>
      </div>
      <a href="tel:0477319160" class="announcement-phone">
        <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        <span>Direct Tech Line: <strong>0477 319 160</strong></span>
      </a>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="main-navbar" id="main-navbar">
    <div class="container nav-container">
      <!-- Brand / Logo -->
      <a href="/" class="brand-link" aria-label="Zoo Computer Repairs Home">
        <div class="brand-logo-icon">
          <span class="satellite-dish-icon">📡</span>
        </div>
        <div class="brand-text-group">
          <span class="brand-name">ZOO REPAIRS</span>
          <span class="brand-tagline">STARLINK & NETWORK SPECIALISTS</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="nav-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Desktop Action CTAs -->
      <div class="header-actions">
        <Button href="tel:0477319160" variant="phone" size="sm">
          <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
          </svg>
          <span>0477 319 160</span>
        </Button>
        <Button href="#quote-form" variant="primary" size="sm">
          <span>Get Free Quote</span>
        </Button>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        class="mobile-menu-toggle"
        id="mobile-menu-toggle"
        aria-label="Open Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Overlay & Panel -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="drawer-backdrop" id="drawer-backdrop"></div>
    <div class="drawer-panel">
      <div class="drawer-header">
        <div class="brand-text-group">
          <span class="brand-name">ZOO REPAIRS</span>
          <span class="brand-tagline">STARLINK SPECIALISTS</span>
        </div>
        <button class="drawer-close" id="drawer-close" aria-label="Close menu">
          <svg viewBox="0 0 20 20" fill="currentColor" width="22" height="22">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>

      <nav class="drawer-nav" aria-label="Mobile Navigation">
        <ul class="drawer-links">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="drawer-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="drawer-cta-group">
        <Button href="tel:0477319160" variant="phone" size="md" class="w-full">
          <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
          </svg>
          <span>Call 0477 319 160</span>
        </Button>
        <Button href="#quote-form" variant="primary" size="md" class="w-full">
          <span>Get Free Online Quote</span>
        </Button>
      </div>

      <div class="drawer-footer-info">
        <p><strong>Zoo Computer Repairs Brisbane</strong></p>
        <p>Expert Starlink rooftop mounting, neat cabling & whole-home WiFi network optimization.</p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
  }

  /* Announcement Bar */
  .announcement-bar {
    background: linear-gradient(90deg, #091322 0%, #0c1a2f 50%, #091322 100%);
    border-bottom: 1px solid rgba(56, 189, 248, 0.2);
    font-size: 0.8125rem;
    color: #cbd5e1;
    padding: 0.45rem 0;
  }

  .announcement-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .announcement-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--action-orange);
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 8px var(--action-orange);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(249, 115, 22, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(249, 115, 22, 0); }
  }

  .announcement-phone {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--starlink-cyan-light);
    font-weight: 500;
    flex-shrink: 0;
  }

  .announcement-phone:hover {
    color: var(--text-white);
  }

  @media (max-width: 768px) {
    .announcement-left span:last-child {
      font-size: 0.75rem;
    }
    .announcement-phone {
      display: none;
    }
  }

  /* Main Navbar */
  .main-navbar {
    background: rgba(11, 17, 32, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
    transition: all var(--transition-smooth);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: 1.5rem;
  }

  /* Brand Logo */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo-icon {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.3) 0%, rgba(14, 165, 233, 0.2) 100%);
    border: 1px solid rgba(56, 189, 248, 0.4);
    border-radius: 0.625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
  }

  .brand-text-group {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-white);
    line-height: 1.1;
  }

  .brand-tagline {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--starlink-cyan-light);
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    font-family: 'Outfit', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color var(--transition-fast);
    padding: 0.4rem 0.2rem;
    position: relative;
  }

  .nav-link:hover {
    color: var(--text-white);
  }

  .nav-link:hover::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--starlink-cyan);
    border-radius: 2px;
  }

  .header-actions {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }
    .header-actions {
      display: flex;
    }
  }

  /* Hamburger Menu */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .burger-bar {
    width: 22px;
    height: 2px;
    background-color: var(--text-white);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    transition: visibility var(--transition-smooth);
  }

  .mobile-drawer.is-open {
    visibility: visible;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 7, 18, 0.8);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity var(--transition-smooth);
  }

  .mobile-drawer.is-open .drawer-backdrop {
    opacity: 1;
  }

  .drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 340px;
    background: var(--bg-secondary);
    border-left: 1px solid var(--border-subtle);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transform: translateX(100%);
    transition: transform var(--transition-smooth);
    overflow-y: auto;
  }

  .mobile-drawer.is-open .drawer-panel {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .drawer-close {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    border-radius: 0.375rem;
    background: rgba(255, 255, 255, 0.05);
  }

  .drawer-close:hover {
    color: var(--text-white);
    background: rgba(255, 255, 255, 0.1);
  }

  .drawer-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .drawer-link {
    display: block;
    font-family: 'Outfit', sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-body);
    padding: 0.6rem 0.5rem;
    border-radius: 0.5rem;
    transition: all var(--transition-fast);
  }

  .drawer-link:hover {
    color: var(--starlink-cyan-light);
    background: rgba(14, 165, 233, 0.08);
    padding-left: 0.85rem;
  }

  .drawer-cta-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .drawer-footer-info {
    font-size: 0.75rem;
    color: var(--text-dim);
    line-height: 1.4;
  }

  .drawer-footer-info strong {
    color: var(--text-muted);
  }

  .w-full {
    width: 100%;
  }
</style>

<script>
  // Mobile drawer interaction
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('drawer-close');
    const backdrop = document.getElementById('drawer-backdrop');
    const drawer = document.getElementById('mobile-drawer');
    const drawerLinks = document.querySelectorAll('.drawer-link');

    const openMenu = () => {
      drawer?.classList.add('is-open');
      drawer?.setAttribute('aria-hidden', 'false');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      drawer?.classList.remove('is-open');
      drawer?.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    toggleBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    drawerLinks.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
        closeMenu();
      }
    });
  });
</script>
