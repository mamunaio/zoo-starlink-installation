<aside class="mobile-call-bar" aria-label="Quick Contact Actions">
  <div class="bar-grid">
    <a href="tel:0477319160" class="bar-btn bar-btn-phone" aria-label="Call Zoo Repairs on 0477 319 160">
      <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
      </svg>
      <span>Call 0477 319 160</span>
    </a>

    <a href="#quote-form" class="bar-btn bar-btn-quote" aria-label="Jump to Free Quote form">
      <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
        <path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z"/>
        <path fill-rule="evenodd" d="M2 6a2 2 0 012-2h4a1 1 0 010 2H4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" clip-rule="evenodd"/>
      </svg>
      <span>Get Free Quote</span>
    </a>
  </div>
</aside>

<style>
  .mobile-call-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 45;
    background: rgba(11, 17, 32, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(56, 189, 248, 0.25);
    padding: 0.65rem 1rem;
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.5);
  }

  @media (min-width: 768px) {
    .mobile-call-bar {
      display: none;
    }
  }

  .bar-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0.65rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .bar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 0.5rem;
    padding: 0.75rem 0.5rem;
    line-height: 1;
    text-align: center;
    transition: transform var(--transition-fast);
  }

  .bar-btn:active {
    transform: scale(0.98);
  }

  .bar-btn-phone {
    background: linear-gradient(135deg, var(--starlink-blue) 0%, #1d4ed8 100%);
    color: var(--text-white);
    border: 1px solid rgba(56, 189, 248, 0.4);
    box-shadow: 0 2px 10px rgba(37, 99, 235, 0.35);
  }

  .bar-btn-quote {
    background: #1e293b;
    color: #ffffff;
    border: 1px solid #475569;
    box-shadow: none;
  }

  .bar-btn-quote:hover {
    background: #334155;
    border-color: #64748b;
    color: #ffffff;
  }
</style>
